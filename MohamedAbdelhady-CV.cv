    {
      "id": "summary",
      "definitionId": "summary",
      "title": "Professional Summary",
      "type": "single",
      "enabled": true,
      "order": 1,
      "fields": [
        { "id": "summary", "label": "Summary", "type": "textarea" }
      ],
      "entries": [
        {
          "summary": "Robotics and AI researcher with a Ph.D. in Electrical Engineering (Dec 2021) and research experience spanning representation learning, system identification, state estimation, reinforcement learning, neural networks, wearable sensing, and model-based control of dynamical robotic systems. Developed learning-based methods for prostheses, pediatric exoskeletons, and human movement estimation using multimodal sensor data, including attention-based deep RNNs for EMG-driven state estimation and deep reinforcement-learning controllers for pediatric exoskeletons. Experienced in designing experimental systems, data-driven models, and hardware-in-the-loop demonstrations. Published in IEEE and robotics/biomedical venues and inventor on multiple U.S. patent applications. Professional Python practitioner (PyTorch, TensorFlow, Scikit-Learn). Former Cleveland Clinic Biomedical Engineering postdoctoral fellow (2021-2022); current Adjunct Assistant Professor at Cleveland State University."
        }
      ]
    },
