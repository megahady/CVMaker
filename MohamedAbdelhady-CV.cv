    {
      "id": "research",
      "definitionId": "research",
      "title": "Research Experience",
      "type": "collection",
      "enabled": true,
      "order": 4,
      "entries": [
        {
          "role": "Postdoctoral Fellow & Associate Investigator",
          "institution": "National Institutes of Health (NIH), Clinical Center",
          "advisor": "Dr. Thomas C. Bulea",
          "startYear": "2022",
          "endYear": "2024",
          "description": "Developed deep learning and reinforcement learning methods for personalized pediatric exoskeleton control, modeling time-varying human movement and system behavior.\nDeveloped neural-network methods for gait and lower-limb state estimation from wearable physiological sensors (EMG-driven knee angle estimation, attention-based deep RNNs).\nDesigned and evaluated a pediatric exoskeleton integrating robotic assistance with functional electrical stimulation.\nDesigned controlled experiments evaluating learned models for accuracy, robustness, and downstream robotic control.\nExplored AI-assisted clinical workflows using NLP and LLMs for healthcare knowledge extraction."
        },
        {
          "role": "Postdoctoral Fellow, Biomedical Engineering",
          "institution": "Cleveland Clinic (Lerner Research Institute)",
          "advisor": "Drs. Margot Damaser & Steve Majerus",
          "startYear": "2021",
          "endYear": "2022",
          "description": "Developed data-driven state/parameter estimation algorithms for detrusor pressure from single-channel bladder pressure recordings; clinically validated using real patient data.\nApplied physiological signal processing and machine learning to improve estimation from limited sensor observations.\nDesigned NLP pipelines extracting structured information from clinical documentation and EHR data; collaborated with clinicians on decision-support tooling; HIPAA-compliant.\nServed as Research Collaboration Coordinator across engineering, clinicians, and students."
        },
        {
          "role": "Research Collaborator",
          "institution": "U.S. Department of Veterans Affairs, Advanced Platform Technology Center",
          "advisor": "Drs. Margot Damaser & Steve Majerus",
          "startYear": "2021",
          "endYear": "2022",
          "description": "Estimation and signal-processing methods for single-channel physiological sensing and pressure reconstruction; co-inventor on resulting U.S. patent applications."
        },
        {
          "role": "Ph.D. Researcher, Electrical Engineering",
          "institution": "Cleveland State University",
          "advisor": "Prof. Dan Simon",
          "startYear": "2015",
          "endYear": "2021",
          "description": "Dissertation: Codesign Development and Control of Smart Prostheses.\nDeveloped learning-based models of lower-limb prostheses (system identification, neural networks, reinforcement learning) and reinforcement-learning impedance control.\nDeveloped a wearable multi-sensor system for lower-limb kinetics/kinematics and reinforcement-learning impedance control for prostheses.\nDesigned hardware-in-the-loop experiments; fabricated prosthesis prototypes via additive manufacturing.\nDeveloped wireless IoT wearable sensing and embedded data-acquisition systems for continuous gait monitoring."
        },
        {
          "role": "Research Engineer",
          "institution": "Ford Motor Company",
          "startYear": "2019",
          "endYear": "2020",
          "description": "Neural-network control and real-time signal-processing systems; presented internal ML research at Ford's AI/ML conference."
        },
        {
          "role": "Engineering Intern",
          "project": "3D reconstruction for MRI; human-assistive robotics",
          "institution": "Siemens",
          "advisor": "Dr. Ivan Fischer",
          "startYear": "2011",
          "description": "3D reconstruction for MRI; human-assistive robotics with Festo."
        }
      ]
    },
